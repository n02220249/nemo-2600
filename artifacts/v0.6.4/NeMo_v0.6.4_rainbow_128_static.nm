NeMo v0.6.4
machine Atari2600
    cpu 6507
    video TIA
    io RIOT

    television NTSC
    visible_scanlines 192

state
    phase : byte = 0

palette TIA128
    hue_count = 16
    light_count = 8

function tia_color(index):
    hue   = index >> 3
    light = index & 7
    return (hue << 4) | (light << 1)

function rainbow_color(scanline):
    index = floor(scanline * 128 / 192)
    return tia_color(index)

kernel RainbowScreen:
    for scanline in 0..191:
        wait_for_scanline()
        color = rainbow_color(scanline)
        TIA.background = color

frame:
    sync()
    blank()
    RainbowScreen
    overscan()

main:
    forever:
        frame()
