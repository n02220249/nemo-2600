NeMo v0.7
machine Atari2600
    cpu 6507
    video TIA
    io RIOT

    television NTSC
    visible_scanlines 192

input P0
    source = joystick
    up    = raw.SWCHA.bit7 active_low
    down  = raw.SWCHA.bit6 active_low
    left  = raw.SWCHA.bit5 active_low
    right = raw.SWCHA.bit4 active_low

host_map Stella
    W -> P0.up
    A -> P0.left
    S -> P0.down
    D -> P0.right

state
    input_raw : byte
    mode_color : byte = 0

function sample_input():
    input_raw = RIOT.SWCHA

    mode_color = 0

    if P0.up:
        mode_color = $1E
    else if P0.left:
        mode_color = $4E
    else if P0.down:
        mode_color = $8E
    else if P0.right:
        mode_color = $CE

function rainbow_color(scanline):
    index = floor(scanline * 128 / 192)
    return TIA128[index]

kernel RainbowScreen:
    for scanline in 0..191:
        wait_for_scanline()
        if state.mode_color != 0:
            TIA.background = state.mode_color
        else:
            TIA.background = rainbow_color(scanline)

frame:
    sync()
    blank()
    sample_input()
    RainbowScreen
    overscan()

main:
    forever:
        frame()
